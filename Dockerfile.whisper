FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
      libsndfile1 \
      curl \
      ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-whisper.txt .
RUN pip install --no-cache-dir -r requirements-whisper.txt
COPY whisper_server.py download_model.py ./

ENV PARAKEET_MODEL=sherpa-onnx-nemo-parakeet-tdt-0.6b-v2-int8 \
    PARAKEET_PROVIDER=cpu \
    WHISPER_DOWNLOAD_ROOT=/models \
    WHISPER_CPU_THREADS=8

EXPOSE 8080
CMD ["uvicorn", "whisper_server:app", "--host", "0.0.0.0", "--port", "8080"]
